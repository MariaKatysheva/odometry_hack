<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_backup_odometry</name>
  <version>1.0.0</version>
  <description>Резервная одометрия трамвая: скорость и положение по колёсам тележек и ручке контроллера (IMM + модель привода + карта)</description>
  <maintainer email="mkkatysheva@gmail.com">Maria Katysheva</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tram_vehicle_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
